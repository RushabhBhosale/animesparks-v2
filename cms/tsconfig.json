{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "strict": true, "noEmit": true, "skipLibCheck": true, "jsx": "react-jsx", "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "isolatedModules": true
  },
  "include": ["core", "server", "mcp", "web/src"]
}
