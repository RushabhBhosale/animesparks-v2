# Copy to cms/.env (gitignored). MONGODB_URI is also read from the site's ../.dev.vars.
MONGODB_URI=""
# Database for the CMS's own collections (cmsProjects, cmsJobs, …). Defaults to MONGODB_DB_NAME / "animesparks".
CMS_DB_NAME=""
# Dashboard login — generate with `npm run setup -- <username>`.
ADMIN_USER=""
ADMIN_PASS_HASH=""
ADMIN_JWT_SECRET=""
CMS_PORT="4400"
CMS_PUBLIC_URL=""
# Media storage: "r2" (Cloudflare REST API) or "local" (cms/.data/media, development only).
CMS_STORAGE="r2"
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
R2_BUCKET="animesparks-staging"
# Optional AI providers (the engine works without them).
AI_TEXT_PROVIDER=""        # anthropic
ANTHROPIC_API_KEY=""
AI_TEXT_MODEL=""           # default claude-opus-5-5
AI_IMAGE_PROVIDER=""       # openai
AI_IMAGE_API_KEY=""
AI_IMAGE_MODEL=""          # default gpt-image-1
# Engine: set CMS_ENGINE="off" to run the dashboard without the background engine.
CMS_ENGINE_INTERVAL_SECONDS="20"
GITHUB_ACTIONS_TOKEN=""    # only for a github_dispatch deploy hook
