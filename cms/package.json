{
  "name": "animesparks-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/node.ts",
    "start": "tsx server/node.ts",
    "engine": "tsx server/engine-cli.ts",
    "mcp": "tsx mcp/stdio.ts",
    "web:dev": "vite",
    "web:build": "vite build",
    "check": "tsc --noEmit",
