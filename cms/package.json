    "worker:dev": "wrangler dev --port 4410",
    "worker:secrets": "tsx server/worker-secrets.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^2.1.6",
