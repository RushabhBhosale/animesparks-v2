---
import ListingPage from '../../components/ListingPage.astro';
import { getBuildData } from '../../lib/content/build-data';
import { getPage, listingHref, paginate, sortArticles } from '../../lib/content/listing';
import { SITE } from '../../lib/content/seo';
const query = (Astro.url.searchParams.get('q') || '').trim();
const sort = Astro.url.searchParams.get('sort') || '';
const page = getPage(Astro.url.searchParams.get('page'));
if (!page) return new Response('Page not found', { status: 404 });
export const prerender = true;
const { spanish: articles, categories } = await getBuildData();
const normalized = query.toLowerCase();
const filtered = normalized ? articles.filter(article => [article.title, article.metaDescription, article.excerpt].some(value => value?.toLowerCase().includes(normalized))) : articles;
const result = paginate(sortArticles(filtered, sort), page);
if (!result.valid) return new Response('Page not found', { status: 404 });
const canonical = SITE + listingHref('/blogs/es', { q: query || undefined, sort: sort || undefined }, page);
---
<ListingPage eyebrow="El archivo editorial" heading="Blogs en español" description="Análisis, personajes y las ideas detrás de tus series favoritas." metaDescription="Browse AnimeSparks articles in Spanish, including analysis, explanations, and editorial deep dives." title={`Anime Blogs in Spanish${page > 1 ? ` · Page ${page}` : ''} | AnimeSparks`} canonical={canonical} posts={result.items} categories={categories} locale="es" path="/blogs/es" query={query} sort={sort} page={page} pageCount={result.pageCount} total={result.total} showSearch showExcerpt={false} />
