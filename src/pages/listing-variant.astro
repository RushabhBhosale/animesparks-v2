---
import { env } from 'cloudflare:workers';
import { getGa4PageViews } from '../lib/content/ga4-rankings';
import ListingPage from '../components/ListingPage.astro';
import { loadListingData } from '../lib/content/listing-data';
import { getPage } from '../lib/content/listing';
import { buildListing, listingNeedsViews } from '../lib/content/listing-view';

// On-demand listings: free-text search, sort orders and GA4-ranked views.
// Plain pagination is prerendered (src/pages/listing-pages) and never lands here.
const target = Astro.url.searchParams.get('target') || '';
const page = getPage(Astro.url.searchParams.get('page'));
if (!page) return new Response('Page not found', { status: 404 });
const source = await loadListingData(env.ASSETS, Astro.url.toString());
const sort = Astro.url.searchParams.get('sort') || '';
const range = Astro.url.searchParams.get('range') || 'month';
const views = listingNeedsViews(target, sort)
  ? await getGa4PageViews(env, range === 'week' ? 'week' : range === 'year' ? 'year' : 'month')
  : null;
const view = buildListing(source, { target, page, query: Astro.url.searchParams.get('q') || '', sort, range, views });
if ('status' in view) return new Response(view.message, { status: view.status });
---
<ListingPage {...view.listing} />
