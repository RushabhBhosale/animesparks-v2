---
import SiteLayout from '../layouts/SiteLayout.astro';
import { Image } from 'astro:assets';
import Card from '../components/Card.astro';
import AdUnit from '../components/AdUnit.astro';
import { getBuildData } from '../lib/content/build-data';
import { r2ImageDimensions, r2ImageUrl } from '../lib/content/images';
import { SITE, homeDescription, homeImage, homeTitle } from '../lib/content/seo';

export const prerender = true;
const data = (await getBuildData()).home;
const featured = data.featured;
const hero = r2ImageUrl(featured?.mainImage);
const heroDimensions = r2ImageDimensions(featured?.mainImage);
---

<SiteLayout title={homeTitle} description={homeDescription} canonical={SITE} image={homeImage} showFooterAd>
  <main class="home-page">
    <div class="shell">
      <!-- Edition Header Strip -->
      <!-- Quick Section Navigation -->
      <nav class="section-nav" aria-label="Editorial sections">
        <span class="section-nav__label">Explore</span>
        {data.sections.map(section => (
          <a href={`/categories/${section.slug}`}>{section.title}</a>
        ))}
        <a class="section-nav__all" href="/categories">All sections ↗</a>
      </nav>

      <!-- Featured Story / Cover Story -->
      {featured && (
        <section class:list={['cover-story', !hero && 'cover-story--text-only']} aria-labelledby="cover-title" data-homepage-article={featured.translationOfSanityId || featured.sanityId}>
          <div class="cover-story__copy">
            <div class="cover-story__eyebrow">
              <span class="kicker red">Cover Story</span>
              {featured.categories[0] && (
                <a class="cover-story__category" href={`/categories/${featured.categories[0].slug}`}>
                  {featured.categories[0].title}
                </a>
              )}
            </div>

            <h1 id="cover-title" class="cover-story__title">
              <a href={`/blog/${featured.slug}`}>{featured.title}</a>
            </h1>

            {featured.excerpt && (
              <p class="cover-story__excerpt">{featured.excerpt}</p>
            )}

            <div class="cover-story__meta">
              <span>{featured.author?.name || 'AnimeSparks Editorial'}</span>
              {featured.publishedAt && (
                <time datetime={featured.publishedAt}>
                  {new Date(featured.publishedAt).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
              )}
            </div>

            <a class="cover-story__cta" href={`/blog/${featured.slug}`}>
              <span>Read the story</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>

          {hero && (
            <div class="cover-story__image-wrap">
              <a href={`/blog/${featured.slug}`} aria-label={`Read ${featured.title}`}>
                <Image
                  src={hero}
                  alt={featured.mainImage?.alt || featured.title}
                  widths={[480, 800, 1200]}
                  sizes="(max-width: 700px) 100vw, 50vw"
                  format="webp"
                  quality={80}
                  {...(heroDimensions ? { width: heroDimensions.width, height: heroDimensions.height } : { inferSize: true })}
                  fetchpriority="high"
                  loading="eager"
                  decoding="async"
                />
              </a>
            </div>
          )}
        </section>
      )}

      <!-- Editor's Picks -->
      {data.editorsPicks.length > 0 && (
        <section class="editorial-section" aria-labelledby="editors-heading">
          <div class="section-header">
            <div>
              <p class="kicker">Selected Reading</p>
              <h2 id="editors-heading">Editor’s Picks<span class="text-accent">.</span></h2>
            </div>
            <a class="section-header__link" href="/blogs">Explore the archive ↗</a>
          </div>
          <div class="card-grid card-grid--3">
            {data.editorsPicks.map(article => (
              <Card article={article} variant="large" homepageSelection />
            ))}
          </div>
        </section>
      )}

      <AdUnit slot="horizontal1" />

      <!-- Latest Stories + Editorial Sidebar -->
      <div class="home-columns editorial-section">
        <section class="home-main" aria-labelledby="latest-heading">
          <div class="section-header">
            <div>
              <p class="kicker">From the Editorial Desk</p>
              <h2 id="latest-heading">Latest Stories<span class="text-accent">.</span></h2>
            </div>
            <a class="section-header__link" href="/blogs">View all ↗</a>
          </div>

          <div class="story-list">
            {data.latest.map(article => (
              <Card article={article} variant="horizontal" homepageSelection />
            ))}
          </div>

          <div style="margin-top: 32px;">
            <a class="outline-button" href="/blogs">Browse full archive ↗</a>
          </div>
        </section>

        <!-- Sidebar -->
        <aside class="home-sidebar">
            <section class="side-panel" aria-labelledby="popular-heading" data-ga-ranking-panel="popular" hidden>
              <p class="side-panel__label">The Reading List</p>
              <h2 id="popular-heading">Popular this week</h2>
              <ol data-ga-rankings="popular"></ol>
            </section>

          {data.sections.length > 0 && (
            <section class="side-panel" aria-labelledby="sections-heading">
              <p class="side-panel__label">Find Your Next Read</p>
              <h2 id="sections-heading">Editorial Sections</h2>
              <div class="side-links">
                {data.sections.map(section => (
                  <a class="side-link" href={`/categories/${section.slug}`}>
                    <span>{section.title}</span>
                    <span aria-hidden="true">→</span>
                  </a>
                ))}
              </div>
            </section>
          )}

          <AdUnit slot="sidebar" />

          <section class="side-panel panel-highlight" aria-labelledby="rss-heading">
            <p class="side-panel__label">Stay Updated</p>
            <h2 id="rss-heading">A closer look at anime.</h2>
            <p>New essays, character studies, and episode breakdowns directly in your feed.</p>
            <div style="margin-top: 16px;">
              <a href="/rss.xml">Follow via RSS feed ↗</a>
            </div>
          </section>
        </aside>
      </div>

      <AdUnit slot="horizontal2" />

      <!-- Anime Series In Focus (Clusters) -->
      {data.animeClusters.length > 0 && (
        <section class="editorial-section" aria-labelledby="clusters-heading">
          <div class="section-header">
            <div>
              <p class="kicker">Series in Focus</p>
              <h2 id="clusters-heading">Explore by Anime<span class="text-accent">.</span></h2>
            </div>
            <a class="section-header__link" href="/my-anime-list">Anime database ↗</a>
          </div>
          <div class="cluster-grid">
            {data.animeClusters.map(cluster => {
              const coverUrl = r2ImageUrl(cluster.cover);
              const coverDimensions = r2ImageDimensions(cluster.cover);
              return (
                <a class="cluster-card" href={`/search?q=${encodeURIComponent(cluster.name)}`}>
                  {coverUrl && (
                    <Image
                      src={coverUrl}
                      alt={cluster.name}
                      widths={[320, 640, 960]}
                      sizes="(max-width: 700px) calc(100vw - 32px), 33vw"
                      format="webp"
                      quality={80}
                      {...(coverDimensions
                        ? { width: coverDimensions.width, height: coverDimensions.height }
                        : { inferSize: true })}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <div class="cluster-card__text">
                    <span>{cluster.name}</span>
                    <small>{cluster.count} {cluster.count === 1 ? 'article' : 'articles'}</small>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}

      <!-- Trending Section -->
        <section class="editorial-section" aria-labelledby="trending-heading" data-ga-ranking-panel="trending" hidden>
          <div class="section-header">
            <div>
              <p class="kicker">In Focus</p>
              <h2 id="trending-heading">Trending Now<span class="text-accent">.</span></h2>
            </div>
            <a class="section-header__link" href="/trending">All trending ↗</a>
          </div>
          <div class="card-grid card-grid--3" data-ga-rankings="trending"></div>
        </section>

      <!-- Spanish Content Section (if available) -->
      {data.spanish.length > 0 && (
        <section class="editorial-section" aria-labelledby="spanish-heading">
          <div class="section-header">
            <div>
              <p class="kicker">Edición en Español</p>
              <h2 id="spanish-heading">AnimeSparks en Español<span class="text-accent">.</span></h2>
            </div>
            <a class="section-header__link" href="/blogs/es">Ver todos en español ↗</a>
          </div>
          <div class="card-grid card-grid--3">
            {data.spanish.map(article => (
              <Card article={article} variant="standard" locale="es" homepageSelection />
            ))}
          </div>
        </section>
      )}
    </div>
  </main>
</SiteLayout>

<script>
  function createRankedCard(article: {
    title: string; href: string; image?: string; alt?: string; publishedAt?: string;
    category?: string; categoryHref?: string; author?: string;
  }) {
    const card = document.createElement('article');
    card.className = 'card';
    const imageLink = document.createElement('a');
    imageLink.className = 'card__image-link';
    imageLink.href = article.href;
    imageLink.setAttribute('aria-label', `Read ${article.title}`);
    if (article.image) {
      const image = document.createElement('img');
      image.src = article.image;
      image.alt = article.alt || article.title;
      image.loading = 'lazy';
      image.decoding = 'async';
      imageLink.append(image);
    } else {
      const placeholder = document.createElement('div');
      placeholder.className = 'card__placeholder';
      placeholder.setAttribute('aria-hidden', 'true');
      imageLink.append(placeholder);
    }
    const body = document.createElement('div');
    body.className = 'card__body';
    const meta = document.createElement('div');
    meta.className = 'card__meta';
    if (article.category && article.categoryHref) {
      const category = document.createElement('a');
      category.className = 'card__category';
      category.href = article.categoryHref;
      category.textContent = article.category;
      meta.append(category);
    }
    if (article.publishedAt) {
      const date = document.createElement('time');
      date.className = 'card__date';
      date.dateTime = article.publishedAt;
      date.textContent = new Date(article.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
      meta.append(date);
    }
    const heading = document.createElement('h3');
    heading.className = 'card__title';
    const link = document.createElement('a');
    link.href = article.href;
    link.textContent = article.title;
    heading.append(link);
    const author = document.createElement('span');
    author.className = 'card__author';
    author.textContent = article.author || 'AnimeSparks Editorial';
    body.append(meta, heading, author);
    card.append(imageLink, body);
    return card;
  }

  async function refreshGoogleAnalyticsRankings() {
    try {
      const selected = [...document.querySelectorAll<HTMLElement>('[data-homepage-article]')]
        .map(element => element.dataset.homepageArticle).filter(Boolean);
      const response = await fetch(`/api/ga-rankings.json?exclude=${encodeURIComponent(selected.join(','))}`, { headers: { Accept: 'application/json' } });
      if (!response.ok) return;
      const rankings = await response.json() as { popular: Array<{ title: string; href: string }>; trending: Array<Parameters<typeof createRankedCard>[0]>; source: string };
      if (rankings.source !== 'ga4') return;
      const popular = document.querySelector<HTMLOListElement>('[data-ga-rankings="popular"]');
      if (popular && rankings.popular.length) {
        popular.replaceChildren(...rankings.popular.map((article, index) => {
          const item = document.createElement('li');
          const number = document.createElement('span');
          number.className = 'side-panel__num';
          number.textContent = String(index + 1).padStart(2, '0');
          const link = document.createElement('a');
          link.href = article.href;
          link.textContent = article.title;
          item.append(number, link);
          return item;
        }));
        document.querySelector<HTMLElement>('[data-ga-ranking-panel="popular"]')?.removeAttribute('hidden');
      }
      const trending = document.querySelector<HTMLElement>('[data-ga-rankings="trending"]');
      if (trending && rankings.trending.length) {
        trending.replaceChildren(...rankings.trending.map(createRankedCard));
        document.querySelector<HTMLElement>('[data-ga-ranking-panel="trending"]')?.removeAttribute('hidden');
      }
    } catch {
      // These sections remain hidden until real GA4 rankings are available.
    }
  }

  void refreshGoogleAnalyticsRankings();
</script>
