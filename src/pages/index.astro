---
import { env } from 'cloudflare:workers';
import SiteLayout from '../layouts/SiteLayout.astro';
import Card from '../components/Card.astro';
import { withDatabase } from '../lib/content/mongodb';
import { getHomepage } from '../lib/content/homepage';
import { r2ImageUrl } from '../lib/content/images';
import { SITE, homeDescription, homeImage, homeTitle } from '../lib/content/seo';
const data = await withDatabase(env.MONGODB_URI, getHomepage);
const featured = data.featured;
const hero = r2ImageUrl(featured?.mainImage);
---
<SiteLayout title={homeTitle} description={homeDescription} canonical={SITE} image={homeImage}>
  <main class="home-page"><div class="shell">
    <div class="edition-line"><span><i></i> Independent anime editorial</span><span>Analysis / Characters / Culture</span></div>
    <nav class="section-nav" aria-label="Editorial sections"><span class="kicker">Explore</span>{data.sections.map(section => <a href={`${SITE}/categories/${section.slug}`}>{section.title}</a>)}<a href={`${SITE}/categories`}>All sections ↗</a></nav>
    {featured && <section class="cover-story" aria-labelledby="cover-title">
      <div class="cover-story__copy"><p class="kicker lime">The cover story <span class="muted">/ 01</span></p>{featured.categories[0] && <a class="category-link" href={`${SITE}/categories/${featured.categories[0].slug}`}>{featured.categories[0].title}</a>}<h1 id="cover-title"><a href={`/blog/${featured.slug}`}>{featured.title}</a></h1><p class="cover-story__deck">{featured.excerpt}</p><p class="cover-story__byline">{featured.author?.name || 'AnimeSparks Editorial'} {featured.publishedAt && <time datetime={featured.publishedAt}>{new Date(featured.publishedAt).toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' })}</time>}</p><a class="read-button" href={`/blog/${featured.slug}`}>Read the story ↗</a></div>
      {hero && <a class="cover-story__image" href={`/blog/${featured.slug}`} aria-label={`Read ${featured.title}`}><img src={hero} alt={featured.mainImage?.alt || featured.title} fetchpriority="high" /><span>AnimeSparks · Featured Story</span></a>}
    </section>}
    <section class="editorial-section" aria-labelledby="editors-heading"><div class="section-heading"><div><p class="kicker">Selected reading</p><h2 id="editors-heading">Editor’s picks<span class="red">.</span></h2></div><a href={`${SITE}/blogs`}>Explore the archive ↗</a></div><div class="card-grid">{data.editorsPicks.map(article => <Card article={article} />)}</div></section>
    <div class="home-columns editorial-section"><section aria-labelledby="latest-heading"><div class="section-heading"><div><p class="kicker">From the editorial desk</p><h2 id="latest-heading">Latest stories<span class="red">.</span></h2></div><a href={`${SITE}/blogs`}>View all ↗</a></div><div class="story-list">{data.latest.map(article => <Card article={article} layout="row" />)}</div><a class="archive-link" href={`${SITE}/blogs`}>Browse all blogs ↗</a></section><aside class="home-sidebar"><section class="side-panel"><p class="kicker">The reading list</p><h2>Popular this week</h2><ol>{data.popular.map((article, index) => <li><span>{String(index + 1).padStart(2,'0')}</span><a href={`/blog/${article.slug}`}>{article.title}</a></li>)}</ol></section><section class="side-panel"><p class="kicker">Find your next read</p><h2>Editorial sections</h2>{data.sections.map(section => <a class="side-link" href={`${SITE}/categories/${section.slug}`}>{section.title} ↗</a>)}</section><section class="side-panel rss-panel"><p class="kicker">Keep reading</p><h2>A closer look at anime.</h2><p>New essays, character studies, and story breakdowns in your feed reader.</p><a href={`${SITE}/rss.xml`}>Follow via RSS ↗</a></section></aside></div>
  </div></main>
</SiteLayout>
