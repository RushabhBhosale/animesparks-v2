---
import ToolPage from '../../../components/tools/ToolPage.astro';
import ShareBox from '../../../components/tools/ShareBox.astro';
import GuideDirectory from '../../../components/tools/GuideDirectory.astro';
import { getBuildData } from '../../../lib/content/build-data';
import { SITE } from '../../../lib/content/seo';
import { getToolsBuildData, relatedArticles } from '../../../lib/tools/build-data';
import { getToolsExtras, type SourceEntry } from '../../../lib/tools/build-extras';
import { ARC_LANDINGS, MANGA_LANDINGS, fitTitle, type ArcLanding } from '../../../lib/tools/landings';
import { arcKey, buildArcGuide, isFillerArc } from '../../../lib/tools/arc-guide';
import { compactKey } from '../../../lib/tools/normalize';

export const prerender = true;
export async function getStaticPaths() {
  const { source } = await getToolsExtras((await getBuildData()).english);
  // Only series where every listed season has an imported arc list.
  return ARC_LANDINGS
    .filter(landing => landing.entries.every(slug => source[slug]?.arcs?.arcs.length))
    .map(landing => ({ params: { slug: landing.slug }, props: { landing } }));
}

const { landing } = Astro.props as { landing: ArcLanding };
const { english } = await getBuildData();
const [{ bySlug, franchises }, extras] = await Promise.all([getToolsBuildData(), getToolsExtras(english)]);
const entries = landing.entries.map(slug => extras.source[slug]).filter((entry): entry is SourceEntry & { arcs: NonNullable<SourceEntry['arcs']> } => Boolean(entry?.arcs));
const fillerBySlug = new Map(extras.filler.filter(view => view.indexable).map(view => [view.slug, view]));
const rows = buildArcGuide(entries.map(entry => ({
  slug: entry.slug,
  title: entry.title,
  episodes: entry.episodes,
  arcs: entry.arcs.arcs,
  ranges: entry.mapping?.ranges,
  episodeTypes: fillerBySlug.has(entry.slug) ? new Map(fillerBySlug.get(entry.slug)!.episodes.map(episode => [episode.n, episode.type])) : undefined,
})));
const multiSeason = entries.length > 1;
const path = `/tools/anime-arc-explorer/${landing.slug}`;
const totalEpisodes = rows.reduce((sum, row) => sum + row.length, 0);
// An arc interrupted by a flashback appears twice in the table but counts once.
const arcCount = new Set(rows.map(row => arcKey(row.name))).size;
const fillerArcs = rows.filter(isFillerArc);
const hasChapters = rows.some(row => row.chapters);
const hasFiller = rows.some(row => row.filler > 0);
const longest = rows.reduce((best, row) => row.length > best.length ? row : best, rows[0]);
const latest = entries.at(-1)!;
const isAiring = latest.status === 'airing';
const franchise = franchises.find(item => item.slug === bySlug.get(entries[0].slug)?.franchiseSlug && item.indexable);
const mangaLanding = MANGA_LANDINGS.find(item => item.slug === landing.slug && item.entries.every(slug => extras.source[slug]?.mapping));
const sources = [...new Map(entries.flatMap(entry => entry.arcs.sources).map(source => [source.url.split('/wiki/')[0], source])).values()];
const keys = new Set(entries.flatMap(entry => { const item = bySlug.get(entry.slug); return item ? [item.title, item.titleEnglish, item.titleRomaji, ...(item.legacy?.articleAnimeNames || [])] : []; })
  .filter((value): value is string => Boolean(value)).map(compactKey).filter(key => key.length > 2));
const span = (start: number, end: number) => start === end ? String(start) : `${start}–${end}`;
const where = (row: (typeof rows)[number]) => row.seasons.map(part => multiSeason ? `${part.title} ep. ${span(part.episodeStart, part.episodeEnd)}` : `Ep. ${span(part.episodeStart, part.episodeEnd)}`).join(' + ');
const list = (names: string[]) => names.length > 1 ? `${names.slice(0, -1).join(', ')} and ${names.at(-1)}` : names[0];

const title = fitTitle([`${landing.name} Arcs in Order: All ${arcCount} Story Arcs & Episodes`, `${landing.name} Arcs in Order: All ${arcCount} Arcs`, `${landing.name} Arcs in Order`]);
const description = `All ${arcCount} ${landing.name} arcs in order, from ${rows[0].name} to ${rows.at(-1)!.name}, with episode ranges${hasChapters ? ', manga chapters' : ''}${fillerArcs.length ? ' and the filler arcs you can skip' : ''}.`;
const faq = [
  { question: `How many arcs are in ${landing.name}?`, answer: `${arcCount} story arcs across ${totalEpisodes} episodes${multiSeason ? ` and ${entries.length} seasons` : ''}${isAiring ? ', counting the episodes aired so far' : ''}.` },
  { question: `What is the longest ${landing.name} arc?`, answer: `${longest.name}, at ${longest.length} episodes (${where(longest)}).` },
  ...(fillerArcs.length
    ? [{ question: `Which ${landing.name} arcs are filler?`, answer: `${fillerArcs.length === 1 ? 'One arc is' : `${fillerArcs.length} arcs are`} entirely filler: ${list(fillerArcs.slice(0, 12).map(row => row.name))}${fillerArcs.length > 12 ? ', and more in the table above' : ''}. You can skip ${fillerArcs.length === 1 ? 'it' : 'them'} without missing the main story.` }]
    : hasFiller ? [] : [{ question: `Does ${landing.name} have filler arcs?`, answer: `No. None of the arcs listed here are filler.` }]),
  { question: `What is the ${isAiring ? 'latest' : 'final'} ${landing.name} arc in the anime?`, answer: `${rows.at(-1)!.name} (${where(rows.at(-1)!)})${isAiring ? `, while ${latest.title} is still airing` : ''}.` },
];
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'ItemList', name: `${landing.name} arcs in order`, numberOfItems: rows.length,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  itemListElement: rows.map((row, index) => ({ '@type': 'ListItem', position: index + 1, name: row.name })),
}];
const otherGuides = ARC_LANDINGS.filter(item => item.slug !== landing.slug && item.entries.every(slug => extras.source[slug]?.arcs?.arcs.length));
---
<ToolPage
  toolSlug="anime-arc-explorer"
  path={path} title={title} socialTitle={`${landing.name} arcs in order`} description={description}
  name={`${landing.name} arcs in order`} crumb={landing.name} parent={['Arc Explorer', '/tools/anime-arc-explorer']}
  kicker="Story arcs" heading={`${landing.name} arcs in order`}
  deck={`Every ${landing.name} story arc from ${rows[0].name} to ${rows.at(-1)!.name}, with ${list(['the episodes it covers', ...(hasChapters ? ['the manga chapters it adapts'] : []), ...(hasFiller ? ['how much of it is filler'] : [])])}.`}
  facts={[
    [String(arcCount), 'story arcs'],
    [String(totalEpisodes), isAiring ? 'episodes so far' : 'episodes'],
    ...(fillerArcs.length ? [[String(fillerArcs.length), fillerArcs.length === 1 ? 'filler arc' : 'filler arcs'] as [string, string]] : []),
  ]}
  faq={faq} related={relatedArticles(english, keys, 6)} relatedHeading={`More on ${landing.name}`}
  credit="Anime details" application={false} image={bySlug.get(entries[0].slug)?.images?.poster} jsonLd={jsonLd}
>
  <ShareBox slot="after-faq" url={`${SITE}${path}`} title={`${landing.name} arcs in order`} anchor={`${landing.name} arcs in order`} />

  <section class="tool-section" aria-labelledby="arcs-title">
    <h2 id="arcs-title">All {arcCount} {landing.name} arcs in order</h2>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr>
            <th scope="col">#</th><th scope="col">Arc</th><th scope="col">Episodes</th><th scope="col">Length</th>
            {hasChapters && <th scope="col">Manga chapters</th>}
            {hasFiller && <th scope="col">Filler</th>}
          </tr>
        </thead>
        <tbody>
          {rows.map((row, index) => (
            <tr>
              <td>{index + 1}</td>
              <td><strong>{row.name}</strong>{isFillerArc(row) && <> <span class="type-badge" data-type="filler">Filler</span></>}</td>
              <td>{where(row)}</td>
              <td>{row.length}</td>
              {hasChapters && <td>{row.chapters ? span(row.chapters[0], row.chapters[1]) : isFillerArc(row) ? 'Anime original' : '—'}</td>}
              {hasFiller && <td>{row.filler ? `${row.filler} of ${row.length}` : '—'}</td>}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="order-sources">
      Arc names and episode ranges: {sources.map((source, index) => <>{index > 0 && ', '}<a href={source.url} rel="nofollow noopener" target="_blank">{source.name}</a></>)} (CC BY-SA), read through the wiki’s API.
      {hasChapters && ' Chapters come from each episode’s “adapted from” field.'}
      {hasFiller && ' Filler counts use the episode flags from our filler list.'}
    </p>
  </section>

  <section class="tool-section" aria-labelledby="plan-title">
    <h2 id="plan-title">More {landing.name} guides</h2>
    <ul class="tool-guide" style="margin:0;padding-left:1.2em">
      {entries.filter(entry => fillerBySlug.has(entry.slug)).map(entry => <li><a href={`/tools/anime-filler-checker/${entry.slug}`}>{fillerBySlug.get(entry.slug)!.title} filler list</a>: every episode you can skip.</li>)}
      {franchise && <li><a href={`/tools/anime-watch-order/${franchise.slug}`}>{franchise.title} watch order</a>: every season, movie and special in release order.</li>}
      {mangaLanding && <li><a href={`/tools/anime-manga-chapter-finder/${mangaLanding.slug}`}>{mangaLanding.name} anime to manga guide</a>: where to continue reading.</li>}
      <li><a href="/tools/anime-arc-explorer">Arc Explorer</a>: tick off arcs as you finish them.</li>
    </ul>
  </section>

  <GuideDirectory
    id="more-arcs" heading="More anime arcs in order"
    links={otherGuides.map(item => ({ href: `/tools/anime-arc-explorer/${item.slug}`, label: `${item.name} arcs in order` }))}
  />

  <Fragment slot="guide">
    <h2>About these arcs</h2>
    <p>Long series are easier to follow arc by arc. This list puts every {landing.name} arc{multiSeason ? `, across all ${entries.length} seasons,` : ''} on one timeline in story order. An arc that carries on into the next season is shown once, with both parts.</p>
    <p>Arc names and episode ranges come from the {landing.name} fan wiki, read through its official API. Nothing is estimated: where the wiki doesn’t give chapters for an episode, the chapter column is left blank.</p>
  </Fragment>
</ToolPage>
