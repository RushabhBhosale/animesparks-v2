---
import ToolPage from '../../components/tools/ToolPage.astro';
import AnimePicker from '../../components/tools/AnimePicker.astro';
import { getBuildData } from '../../lib/content/build-data';
import { getToolsExtras } from '../../lib/tools/build-extras';
import { MAX_GUESSES } from '../../lib/tools/daily';

export const prerender = true;
const { english } = await getBuildData();
const { games } = await getToolsExtras(english);
const safeJson = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
const faq = [
  { question: 'When does a new puzzle start?', answer: 'Every day at 00:00 UTC, the same moment for everyone in the world. The countdown shows the time left in your timezone.' },
  { question: 'How do the clues work?', answer: `You get ${MAX_GUESSES} guesses. Each wrong guess or skip reveals a more specific clue: premiere date, genres and themes, studio, episode count and source, then main characters.` },
  { question: 'Where do the puzzles come from?', answer: 'Each day’s anime is picked in advance from the most popular titles on MyAnimeList, and its clues are written from stored data such as studios, genres and characters. Puzzles are fixed once scheduled, so everyone plays the same one, and nothing is generated by AI.' },
  { question: 'Are my stats saved?', answer: 'Your streak, win rate and guess distribution are saved in this browser. Shared results show coloured squares only, never the answer.' },
];
---
<ToolPage
  path="/tools/daily-anime-game" title="Daily Anime Guessing Game — Guess the Anime from Clues | AnimeSparks" socialTitle="Daily Anime Guessing Game"
  description="A new anime to guess every day. Six guesses, clues that get more specific with each one, streaks and spoiler-free results to share. Same puzzle for everyone, worldwide."
  name="Daily Anime Guessing Game" crumb="Daily Game" kicker="Create & play" heading="Daily Anime Guessing Game"
  deck={`One anime, ${MAX_GUESSES} guesses. Each wrong answer reveals a sharper clue. A new puzzle drops every day at 00:00 UTC for everyone.`}
  faq={faq} credit="Clue data"
>
  <div data-game>
    <script type="application/json" id="game-data" set:html={safeJson(games)}></script>
    <section class="tool-panel" aria-labelledby="game-title">
      <div class="tool-panel__head">
        <h2 id="game-title" data-game-title>Today’s puzzle</h2>
        <span class="tool-legend" data-attempts></span>
      </div>
      <div class="tool-panel__body">
        <ol class="game-clues" data-clues></ol>
        <div data-play>
          <AnimePicker id="game-guess" label="Your guess" placeholder="Type an anime title…" />
          <div class="tool-results__actions" style="margin-top: var(--sp-3)">
            <button type="button" class="tool-button" data-skip>Skip — show the next clue</button>
          </div>
        </div>
        <ul class="game-guesses" data-guesses></ul>
        <div data-finish hidden></div>
        <p class="tool-note tool-note--muted" data-missing hidden>Today’s puzzle isn’t available yet. Please check back shortly.</p>
      </div>
    </section>

    <section class="tool-section" aria-labelledby="game-stats-title">
      <h2 id="game-stats-title">Your stats</h2>
      <dl class="stat-row" data-stats>
        <div><dt>Played</dt><dd data-stat="played">0</dd></div>
        <div><dt>Win %</dt><dd data-stat="win">0</dd></div>
        <div><dt>Streak</dt><dd class="is-accent" data-stat="streak">0</dd></div>
        <div><dt>Best streak</dt><dd data-stat="max">0</dd></div>
      </dl>
      <div class="game-dist" data-distribution></div>
      <p class="tool-hero__deck" style="margin-top: var(--sp-4); font-size: var(--text-sm)">Next puzzle in <strong data-countdown>—</strong></p>
    </section>
  </div>

  <Fragment slot="guide">
    <h2>How to play</h2>
    <p>The first clue is broad: the format and when the anime premiered. Guess a title from the search box. A wrong guess, or a skip, reveals the next clue: genres and themes, then the studio, episode count and source, and finally the main characters. Get it within {MAX_GUESSES} tries to keep your streak alive.</p>
    <p>Everyone gets the same anime on the same UTC day, so you can compare results with friends. Share your result to post a grid of squares that shows how many guesses you needed without revealing the answer.</p>
  </Fragment>
</ToolPage>

<style is:global>
  .game-clues { margin: 0 0 var(--sp-5); padding: 0; list-style: none; counter-reset: clue; }
  .game-clues li { position: relative; padding: var(--sp-3) var(--sp-4) var(--sp-3) 52px; border: 1px solid var(--line); border-top: 0; background: var(--surface2); color: var(--ink); line-height: 1.5; counter-increment: clue; }
  .game-clues li:first-child { border-top: 1px solid var(--line); }
  .game-clues li::before { content: counter(clue); position: absolute; left: var(--sp-4); top: var(--sp-3); display: grid; place-items: center; width: 22px; height: 22px; background: var(--accent); color: #fff; font-size: 11px; font-weight: 800; }
  .game-clues li.is-locked { color: var(--ink-3); background: transparent; }
  .game-clues li.is-locked::before { background: var(--line-2); }
  .game-guesses { display: flex; flex-wrap: wrap; gap: var(--sp-2); margin: var(--sp-4) 0 0; padding: 0; list-style: none; }
  .game-guesses li { padding: 4px 10px; border: 1px solid var(--line-2); font-size: var(--text-sm); color: var(--ink-2); }
  .game-guesses li.is-wrong { border-color: color-mix(in srgb, var(--accent) 55%, transparent); text-decoration: line-through; }
  .game-guesses li.is-right { border-color: #6c9a3e; color: #b8e05a; }
  .game-answer { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: var(--sp-5); align-items: center; margin-top: var(--sp-5); padding: var(--sp-5); border: 1px solid var(--line-2); background: var(--bg); }
  .game-answer img, .game-answer .mini-card__thumb { width: 90px; height: 126px; object-fit: cover; background: var(--surface2); }
  .game-answer h3 { margin: 0 0 var(--sp-2); font-family: var(--font-body); font-size: var(--text-2xl); }
  .game-answer p { margin: 0 0 var(--sp-3); color: var(--ink-2); }
  .game-dist { display: grid; gap: 6px; margin-top: var(--sp-4); }
  .game-dist div { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: var(--sp-2); align-items: center; font-size: var(--text-xs); color: var(--ink-3); }
  .game-dist span { display: block; min-width: 24px; padding: 2px 6px; background: var(--line-2); color: var(--ink); text-align: right; font-weight: 700; }
  .game-dist span.is-today { background: var(--accent); }
</style>

<script>
  import { MAX_GUESSES, emptyStats, isCorrectGuess, msUntilNextPuzzle, puzzleNumber, recordResult, shareGrid, utcDateKey, type GameStats } from '../../lib/tools/daily';
  import { countdownParts } from '../../lib/tools/schedule';
  import { createPicker } from '../../scripts/tools/anime-picker';
  import { readLocal, writeLocal } from '../../scripts/tools/storage';

  type Puzzle = { date: string; clues: string[]; a: string };
  type Answer = { slug: string; title: string; alternatives: string[]; poster?: string; franchise?: string };
  type Guess = { slug: string; title: string; correct: boolean };
  type DayState = { guesses: Guess[]; finished: boolean; won: boolean };

  const root = document.querySelector<HTMLElement>('[data-game]')!;
  const puzzles = JSON.parse(document.getElementById('game-data')!.textContent || '[]') as Puzzle[];
  const today = utcDateKey(Date.now());
  const puzzle = puzzles.find(item => item.date === today);
  const decode = (value: string): Answer => JSON.parse(new TextDecoder().decode(Uint8Array.from(atob(value), char => char.charCodeAt(0))));
  const $ = <T extends HTMLElement>(selector: string) => root.querySelector<T>(selector)!;
  const number = puzzleNumber(today);
  let stats = readLocal<GameStats>('daily:stats', emptyStats());
  if (!Array.isArray(stats.distribution) || stats.distribution.length !== MAX_GUESSES) stats = emptyStats();

  function renderStats(highlight?: number) {
    const set = (name: string, value: string) => { $(`[data-stat="${name}"]`).textContent = value; };
    set('played', String(stats.played));
    set('win', stats.played ? String(Math.round((stats.won / stats.played) * 100)) : '0');
    set('streak', String(stats.currentStreak));
    set('max', String(stats.maxStreak));
    const max = Math.max(1, ...stats.distribution);
    $('[data-distribution]').replaceChildren(...stats.distribution.map((count, index) => {
      const row = document.createElement('div');
      const label = document.createElement('b'); label.textContent = String(index + 1);
      const bar = document.createElement('span'); bar.textContent = String(count); bar.style.width = `${Math.max(8, (count / max) * 100)}%`;
      if (highlight === index + 1) bar.classList.add('is-today');
      row.append(label, bar);
      return row;
    }));
  }

  const tick = () => {
    const { hours, minutes, seconds } = countdownParts(msUntilNextPuzzle(Date.now()));
    $('[data-countdown]').textContent = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
    if (utcDateKey(Date.now()) !== today) window.location.reload();
  };
  tick();
  window.setInterval(tick, 1000);
  renderStats();

  if (!puzzle) {
    $('[data-missing]').hidden = false;
    $('[data-play]').hidden = true;
  } else {
    const answer = decode(puzzle.a);
    const key = `daily:${today}`;
    let state = readLocal<DayState>(key, { guesses: [], finished: false, won: false });
    $('[data-game-title]').textContent = `Puzzle #${number}`;

    const render = () => {
      const revealed = state.finished ? MAX_GUESSES : Math.min(state.guesses.length + 1, MAX_GUESSES);
      $('[data-attempts]').textContent = state.finished ? (state.won ? `Solved in ${state.guesses.length}` : 'Out of guesses') : `Guess ${state.guesses.length + 1} of ${MAX_GUESSES}`;
      $('[data-clues]').replaceChildren(...puzzle.clues.slice(0, MAX_GUESSES).map((clue, index) => {
        const item = document.createElement('li');
        if (index < revealed) item.textContent = clue;
        else { item.textContent = 'Revealed after another guess'; item.classList.add('is-locked'); }
        return item;
      }));
      $('[data-guesses]').replaceChildren(...state.guesses.map(guess => {
        const item = document.createElement('li');
        item.textContent = guess.slug === '__skip' ? 'Skipped' : guess.title;
        item.className = guess.correct ? 'is-right' : 'is-wrong';
        return item;
      }));
      $('[data-play]').hidden = state.finished;
      const finish = $('[data-finish]');
      finish.hidden = !state.finished;
      if (state.finished) {
        finish.replaceChildren();
        const box = document.createElement('div'); box.className = 'game-answer';
        if (answer.poster) { const image = document.createElement('img'); image.src = answer.poster; image.alt = ''; image.width = 90; image.height = 126; image.referrerPolicy = 'no-referrer'; box.append(image); }
        else { const thumb = document.createElement('span'); thumb.className = 'mini-card__thumb'; box.append(thumb); }
        const body = document.createElement('div');
        const title = document.createElement('h3'); title.textContent = answer.title;
        const line = document.createElement('p'); line.textContent = state.won ? `You got it in ${state.guesses.length} ${state.guesses.length === 1 ? 'guess' : 'guesses'}!` : 'Better luck tomorrow.';
        const actions = document.createElement('div'); actions.className = 'tool-results__actions';
        const share = document.createElement('button'); share.type = 'button'; share.className = 'tool-button tool-button--primary'; share.textContent = 'Share result';
        share.addEventListener('click', async () => {
          const text = `${shareGrid(number, state.guesses.map(guess => guess.correct), state.won)}\nhttps://www.animesparks.blog/tools/daily-anime-game`;
          if (navigator.share) { try { await navigator.share({ text }); return; } catch (error) { if ((error as Error).name === 'AbortError') return; } }
          try { await navigator.clipboard.writeText(text); share.textContent = 'Copied'; } catch { share.textContent = 'Copy failed'; }
        });
        actions.append(share);
        if (answer.franchise) { const link = document.createElement('a'); link.className = 'tool-button'; link.href = `/tools/anime-watch-order/${answer.franchise}`; link.textContent = 'Watch order'; actions.append(link); }
        const binge = document.createElement('a'); binge.className = 'tool-button'; binge.href = `/tools/anime-binge-calculator?anime=${answer.slug}`; binge.textContent = 'How long to watch?';
        actions.append(binge);
        body.append(title, line, actions);
        box.append(body);
        finish.append(box);
      }
    };

    const submit = (guess: Guess) => {
      if (state.finished) return;
      state = { ...state, guesses: [...state.guesses, guess] };
      if (guess.correct || state.guesses.length >= MAX_GUESSES) {
        state.finished = true;
        state.won = guess.correct;
        stats = recordResult(stats, today, state.won, state.guesses.length);
        writeLocal('daily:stats', stats);
        renderStats(state.won ? state.guesses.length : undefined);
      }
      writeLocal(key, state);
      render();
    };

    createPicker({
      root: root.querySelector<HTMLElement>('[data-picker="game-guess"]')!,
      endpoint: '/api/tools/anime-search',
      onSelect: item => {
        (root.querySelector('[data-picker="game-guess"] input') as HTMLInputElement).value = '';
        if (state.guesses.some(guess => guess.slug === item.s)) return;
        submit({ slug: item.s, title: item.t, correct: isCorrectGuess(item.s, item.t, answer) });
      },
    });
    $('[data-skip]').addEventListener('click', () => submit({ slug: '__skip', title: 'Skipped', correct: false }));
    render();
  }
</script>
