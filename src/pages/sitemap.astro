---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getBuildData } from '../lib/content/build-data';
import { SITE, homeImage } from '../lib/content/seo';
import { LIVE_TOOLS, toolPath } from '../lib/tools/registry';
import { ARC_LANDINGS, MANGA_LANDINGS } from '../lib/tools/landings';
import { getToolsBuildData } from '../lib/tools/build-data';
import { getToolsExtras } from '../lib/tools/build-extras';
import { hasMoviePage } from '../lib/tools/movies';
import { getRecLandingPages } from '../lib/tools/rec-landings';
export const prerender = true;
const { categories, sitemapArticles: articles } = await getBuildData();
const core = [['Home', '/'], ['Blogs', '/blogs'], ['Spanish Blogs', '/blogs/es'], ['My Anime List', '/my-anime-list'], ['Categories', '/categories'], ['Trending', '/trending'], ['Anime Tools', '/tools'], ['About', '/about'], ['Contact', '/contact'], ['Privacy', '/privacy']];
const english = articles.filter(article => article.language === 'en');
const spanish = articles.filter(article => article.language === 'es');
const [{ franchises }, extras] = await Promise.all([getToolsBuildData(), getBuildData().then(data => getToolsExtras(data.english))]);
const byLabel = (a: { label: string }, b: { label: string }) => a.label.localeCompare(b.label, 'en', { sensitivity: 'base' });
const guideGroups = [
  { heading: 'Anime Filler Lists', links: extras.filler.filter(view => view.indexable).map(view => ({ href: `/tools/anime-filler-checker/${view.slug}`, label: `${view.title} filler list` })).sort(byLabel) },
  { heading: 'Anime Watch Orders', links: franchises.filter(franchise => franchise.indexable).map(franchise => ({ href: `/tools/anime-watch-order/${franchise.slug}`, label: `${franchise.title} watch order` })).sort(byLabel) },
  { heading: 'Anime Like Your Favourites', links: (await getRecLandingPages((await getBuildData()).english)).map(({ landing }) => ({ href: `/tools/anime-recommendations/${landing.slug}`, label: `Anime like ${landing.name}` })).sort(byLabel) },
  { heading: 'Anime Movies in Order', links: franchises.filter(hasMoviePage).map(franchise => ({ href: `/tools/anime-watch-order/${franchise.slug}/movies`, label: `${franchise.title} movies in order` })).sort(byLabel) },
  { heading: 'Anime Arcs in Order', links: ARC_LANDINGS.filter(landing => landing.entries.every(slug => extras.source[slug]?.arcs?.arcs.length)).map(landing => ({ href: `/tools/anime-arc-explorer/${landing.slug}`, label: `${landing.name} arcs in order` })).sort(byLabel) },
  { heading: 'Anime to Manga Guides', links: MANGA_LANDINGS.filter(landing => landing.entries.every(slug => extras.source[slug]?.mapping)).map(landing => ({ href: `/tools/anime-manga-chapter-finder/${landing.slug}`, label: `${landing.name}: anime to manga` })).sort(byLabel) },
];
---
<SiteLayout title="Sitemap | AnimeSparks" socialTitle="Sitemap" description="A complete sitemap of AnimeSparks to help users and search engines navigate all pages and anime content easily." canonical={`${SITE}/sitemap`} image={homeImage}>
  <main><header class="page-hero"><div class="shell"><p class="kicker red">Sitemap</p><h1>Site Index<span class="red">.</span></h1><p>A clean map of published posts and core sections.</p></div></header><div class="shell sitemap-page"><section><h2>Main Pages</h2><div class="sitemap-grid">{core.map(([label, href]) => <a href={href}>{label} →</a>)}</div></section><section><h2>Anime Tools</h2><div class="sitemap-grid">{LIVE_TOOLS.map(tool => <a href={toolPath(tool)}>{tool.name} →</a>)}</div></section>{guideGroups.filter(group => group.links.length).map(group => <section><h2>{group.heading}</h2><div class="sitemap-grid">{group.links.map(guide => <a href={guide.href}>{guide.label} →</a>)}</div></section>)}<section><h2>Categories</h2><div class="sitemap-grid">{categories.map(category => <a href={`/categories/${category.slug}`}>{category.title} →</a>)}</div></section><section><h2>Published Posts</h2><div class="sitemap-grid">{english.map(article => <a href={`/blog/${article.slug}`}>{article.title}</a>)}</div></section><section><h2>Spanish Posts</h2><div class="sitemap-grid">{spanish.map(article => <a href={`/es/blog/${article.slug}`}>{article.title}</a>)}</div></section></div></main>
</SiteLayout>
