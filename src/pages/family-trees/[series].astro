---
import SiteLayout from '../../layouts/SiteLayout.astro';
import '../../styles/tools.css';
import '../../styles/characters.css';
import FamilyChart from '../../components/characters/FamilyChart.astro';
import { SITE } from '../../lib/content/seo';
import { familyPath, familySeries } from '../../lib/characters/family.ts';
import { CHARACTERS_IMAGE, crumbList } from '../../lib/characters/seo.ts';

export const prerender = true;
export function getStaticPaths() {
  return familySeries().map(series => ({ params: { series: series.slug }, props: { slug: series.slug } }));
}
const series = familySeries().find(item => item.slug === Astro.props.slug)!;
const guide = series.familyGuide!;
const path = familyPath(series.slug);
const verified = series.profiles.map(item => item.meta.verifiedAt).sort().at(-1)!;
---
<SiteLayout title={guide.seo.title} socialTitle={guide.seo.title} description={guide.seo.description} canonical={`${SITE}${path}`} image={CHARACTERS_IMAGE}
  jsonLd={[crumbList([['Family trees', '/family-trees'], [`${series.short} family tree`, path]]), { '@context': 'https://schema.org', '@type': 'WebPage', name: guide.seo.title, description: guide.seo.description, url: `${SITE}${path}`, dateModified: verified, about: { '@type': 'TVSeries', name: series.title } }]} showFooterAd>
  <main class="fc-page">
    <h1 class="fc-page__title">{series.short} Family Tree</h1>
    <FamilyChart series={series} src={`${path}/roster.json`} />
    <p class="fc-credit">Character data from <a href="https://naruto.fandom.com/" rel="nofollow noopener">Narutopedia</a>, CC BY-SA.</p>
  </main>
</SiteLayout>
