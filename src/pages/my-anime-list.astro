---
import SiteLayout from '../layouts/SiteLayout.astro';
import { getBuildData } from '../lib/content/build-data';
import { SITE, homeImage } from '../lib/content/seo';
export const prerender = true;
const entries = (await getBuildData()).anime;
const average = entries.length ? (entries.reduce((sum, entry) => sum + (entry.score || 0), 0) / entries.length).toFixed(1) : '–';
---
<SiteLayout title="My Anime Watchlist & Ratings | AnimeSparks" socialTitle="My Anime Watchlist & Ratings" description="A personal anime watchlist with ratings and thoughts on every series watched — from mainstream hits to overlooked gems." canonical={`${SITE}/my-anime-list`} image={homeImage}>
  <main><header class="page-hero"><div class="shell"><p class="kicker red">My Anime List</p><h1>Watched Series<span class="red">.</span></h1><p>Every anime I have completed so far, with a quick score.</p></div></header><div class="shell editorial-section"><div class="section-heading"><div><p class="kicker">The watchlist</p><h2>Series List</h2></div><p>{entries.length} series · Avg {average}/10</p></div><p class="list-intro">Scores are out of 10 and based on my personal watch history.</p><ul class="anime-list">{entries.map(entry => <li><div class="anime-entry"><div class="anime-cover">{entry.coverImage?.startsWith('https://') ? <img src={entry.coverImage} alt={`${entry.title} cover`} loading="lazy" /> : <span>No image</span>}</div><div><p class="anime-entry-title">{entry.title}</p><p>{[entry.year, ...(entry.genres || []).slice(0, 3)].filter(Boolean).join(' · ')}</p></div></div><strong>{entry.score}/10</strong></li>)}</ul></div></main>
</SiteLayout>
