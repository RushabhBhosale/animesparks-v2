---
interface Props {
  id: string;
  label: string;
  placeholder: string;
  hint?: string;
}
const { id, label, placeholder, hint } = Astro.props;
---
<div class="anime-picker tool-field" data-picker={id}>
  <label for={`${id}-input`}><span class="tool-legend">{label}</span></label>
  <div class="anime-picker__control">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>
    <input
      id={`${id}-input`}
      class="tool-input"
      type="search"
      role="combobox"
      autocomplete="off"
      spellcheck="false"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls={`${id}-list`}
      placeholder={placeholder}
      maxlength="100"
    />
  </div>
  <ul id={`${id}-list`} class="anime-picker__list" role="listbox" aria-label={label} hidden></ul>
  {hint && <small>{hint}</small>}
</div>
