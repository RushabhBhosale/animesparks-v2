---
// The whole series as one linked tree. The SVG is prerendered, so every name
// is in the HTML; family-chart.ts adds the camera, search and spoiler levels.
import { buildChart, chartSvg, type ChartData } from '../../lib/characters/family-chart.ts';
import { compactRoster } from '../../lib/characters/roster.ts';
import type { FamilySeries } from '../../lib/characters/family.ts';
interface Props { series: FamilySeries; src: string }
const { series, src } = Astro.props;
const data = compactRoster(series.slug) as unknown as ChartData;
const label = `${series.title} family tree`;
const svg = chartSvg(buildChart(data, data.checkpoints - 1, series.short), label);
---
<div class="fc" data-chart data-src={src} data-series={series.slug} data-title={series.short} data-label={label} data-full={data.checkpoints - 1}>
  <div class="fc-bar">
    <div class="fc-search">
      <input class="tool-input" type="search" placeholder="Search any character" aria-label="Search any character" autocomplete="off" data-search />
      <ul class="fc-suggest" data-suggest></ul>
    </div>
    <select class="tool-select" aria-label="Jump to a village or clan" data-jump><option value="">Jump to…</option></select>
    <label class="fc-switch"><input type="checkbox" data-families /> <span>Families only</span></label>
    {series.checkpoints.length > 0 && (
      <select class="tool-select" aria-label="Spoilers" data-spoilers>
        <option value="">Spoilers: show all</option>
        <option value="-1">Hide all spoilers</option>
        {series.checkpoints.slice(0, -1).map((checkpoint, index) => <option value={index}>Hide after {checkpoint.label}</option>)}
      </select>
    )}
    <div class="fc-tools" role="group" aria-label="Page controls">
      <button type="button" data-fullscreen>Fullscreen</button>
      <button type="button" data-share>Share</button>
    </div>
  </div>
  <div class="fc-view" data-view tabindex="0" role="application" aria-label={`${label}. Drag to move, scroll or pinch to zoom.`}>
    <div class="fc-stage" data-stage set:html={svg}></div>
    <nav class="fc-crumbs" data-crumbs aria-label="Where you are in the tree"></nav>
    <div class="fc-zoom" data-zoombar role="group" aria-label="Zoom">
      <button type="button" data-zoom-in aria-label="Zoom in">+</button>
      <button type="button" data-zoom-out aria-label="Zoom out">−</button>
      <button type="button" data-fit aria-label="Show the whole tree" title="Whole tree">⤢</button>
    </div>
    <div class="fc-mini" data-mini aria-hidden="true"><canvas></canvas><span data-mini-frame></span></div>
    <aside class="fc-card" data-card hidden aria-live="polite"></aside>
  </div>
</div>
<script>
  import '../../scripts/characters/family-chart.ts';
</script>
