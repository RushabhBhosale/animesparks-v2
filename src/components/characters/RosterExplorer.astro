---
// Shell for the complete family tree. Clan names and counts are real HTML;
// the roster itself is fetched lazily and drawn by roster-explorer.ts.
import type { ResolvedSeries } from '../../lib/characters/types.ts';
interface Props { series: ResolvedSeries; clans: Array<{ name: string; count: number }>; src: string }
const { series, clans, src } = Astro.props;
const top = [...clans.entries()].map(([index, clan]) => ({ ...clan, index })).sort((a, b) => b.count - a.count).slice(0, 40);
---
<div class="roster" data-roster data-src={src} data-max-level={series.checkpoints.length - 1}>
  <aside class="roster__side" aria-label="Search and clans">
    <div class="roster__search">
      <label class="tool-field"><span>Search any character</span><input class="tool-input" type="search" placeholder="Search characters…" autocomplete="off" data-search /></label>
      <ul class="roster__suggest" data-suggest></ul>
    </div>
    <h2 class="roster__h">View by clan / family</h2>
    <ul class="roster__clans" data-clan-list>
      {top.map(clan => <li><button type="button" data-clan={clan.index} aria-pressed="false"><span>{clan.name}</span><b>{clan.count}</b></button></li>)}
    </ul>
    <h2 class="roster__h">Display options</h2>
    <label class="tool-check"><input type="checkbox" data-only-linked /> <span>Only characters with family links<small>Applies to the list view.</small></span></label>
  </aside>

  <section class="roster__main" aria-label="Family tree">
    <div class="explorer__tabs" role="tablist" aria-label="Views">
      <button type="button" role="tab" aria-selected="true" data-view="clans">Clans</button>
      <button type="button" role="tab" aria-selected="false" data-view="tree">Family tree</button>
      <button type="button" role="tab" aria-selected="false" data-view="list">Character list</button>
    </div>
    <div class="explorer__bar">
      <p class="roster__status" data-status aria-live="polite">Loading the roster…</p>
      <div class="explorer__tools" role="group" aria-label="Map controls">
        <button type="button" data-zoom-out aria-label="Zoom out">−</button><button type="button" data-zoom-in aria-label="Zoom in">+</button>
        <button type="button" data-fit>Fit</button><button type="button" data-fullscreen>Fullscreen</button><button type="button" data-share>Share</button>
      </div>
    </div>
    <div class="explorer__viewport roster__viewport" data-viewport tabindex="0" role="application" aria-label={`${series.title} complete family tree. Drag to pan, pinch or use the buttons to zoom.`}>
      <div class="explorer__stage" data-stage></div>
    </div>
    <p class="explorer__hint">Drag to pan, pinch or Ctrl/⌘ + scroll to zoom. Select a name for details. Lines show parents and children, partners, siblings and generation-skipping lineage. Names without a profile show recorded facts only.</p>
  </section>

  <aside class="roster__detail" data-detail aria-live="polite" aria-label="Character details"><p class="explorer__hint">Select a character to see their family and affiliations.</p></aside>
</div>
<script>
  import '../../scripts/characters/roster-explorer.ts';
</script>
