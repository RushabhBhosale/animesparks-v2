---
import { characterPath } from '../../lib/characters/registry.ts';
import type { FamilyTree } from '../../lib/characters/graph.ts';
import { checkpointIndex } from '../../lib/characters/format.ts';
import type { SeriesData } from '../../lib/characters/types.ts';
interface Props { tree: FamilyTree; label: string; idPrefix?: string; series?: SeriesData; fixed?: boolean }
const { tree, label, idPrefix = 'rel', series, fixed = false } = Astro.props;
const lockOf = (spoiler?: string) => (series ? checkpointIndex(series, spoiler) : -1);
// A relative whose every link is spoiler-protected stays hidden until the first of them unlocks.
const nodeLock = (id: string) => {
  const own = tree.links.filter(link => link.from.id === id || link.to.id === id);
  if (!own.length || own.some(link => !link.relationship.spoiler)) return -1;
  return Math.min(...own.map(link => lockOf(link.relationship.spoiler)));
};
const W = 132;
const H = 36;
const clip = (name: string) => (name.length > 18 ? `${name.slice(0, 17)}…` : name);
const paths = tree.links.map(link => {
  const { from, to } = link;
  if (link.kind === 'parent' || link.kind === 'lineage') {
    const midY = (from.y + H / 2 + to.y - H / 2) / 2;
    return { d: `M${from.x},${from.y + H / 2} V${midY} H${to.x} V${to.y - H / 2}`, kind: link.kind, link };
  }
  const left = from.x <= to.x ? from : to;
  const right = left === from ? to : from;
  if (left.y !== right.y) return { d: `M${from.x},${from.y} L${to.x},${to.y}`, kind: link.kind, link };
  const bow = link.kind === 'sibling' ? -H / 2 - 12 : 0;
  return link.kind === 'sibling'
    ? { d: `M${left.x},${left.y - H / 2} V${left.y + bow} H${right.x} V${right.y - H / 2}`, kind: link.kind, link }
    : { d: `M${left.x + W / 2},${left.y} H${right.x - W / 2}`, kind: link.kind, link };
});
---
<div class={fixed ? 'tree-fixed' : 'graph-wrap'}>
  <svg viewBox={`0 0 ${tree.width} ${tree.height}`} width={fixed ? tree.width : undefined} height={fixed ? tree.height : undefined} role="group" aria-label={label} data-family-tree>
    <g aria-hidden="true">
      {Array.from({ length: tree.generations }, (_, generation) => (
        <g>
          <line x1="0" x2={tree.width} y1={44 + generation * 112 + 56} y2={44 + generation * 112 + 56} stroke="var(--line)" stroke-dasharray="2 6" opacity={generation < tree.generations - 1 ? 1 : 0} />
          <text x="8" y={44 + generation * 112 - 24} class="tree-label" style="text-anchor:start">Generation {generation + 1}</text>
        </g>
      ))}
    </g>
    <g>
      {paths.map(path => (
        <a href={`#${idPrefix}-${path.link.relationship.id}`} data-a={path.link.from.id} data-b={path.link.to.id} data-spoiler-idx={lockOf(path.link.relationship.spoiler) >= 0 ? lockOf(path.link.relationship.spoiler) : undefined} data-spoiler-hide={lockOf(path.link.relationship.spoiler) >= 0 ? '' : undefined} {...(lockOf(path.link.relationship.spoiler) >= 0 ? { hidden: true } : {})}>
          <path class={`tree-line tree-line--${path.kind}`} d={path.d} />
          <path d={path.d} stroke="transparent" stroke-width="14" fill="none" />
          <title>{path.link.from.name} · {path.link.to.name}: {path.link.relationship.roles ? `${path.link.relationship.roles.a} / ${path.link.relationship.roles.b}` : path.link.relationship.kin}</title>
        </a>
      ))}
    </g>
    <g>
      {tree.nodes.map(node => (
        <g class={`node${node.focus ? ' node--focus' : ''}${node.profile ? '' : ' node--plain'}`} data-id={node.id} data-name={node.name} data-spoiler-idx={nodeLock(node.id) >= 0 ? nodeLock(node.id) : undefined} data-spoiler-hide={nodeLock(node.id) >= 0 ? '' : undefined} {...(nodeLock(node.id) >= 0 ? { hidden: true } : {})} transform={`translate(${node.x - W / 2},${node.y - H / 2})`}>
          {node.profile && !node.focus
            ? <a href={characterPath(node.profile)} aria-label={`${node.name}: character profile`}><rect width={W} height={H} /><text x={W / 2} y={H / 2}>{clip(node.name)}</text></a>
            : <g><rect width={W} height={H} /><text x={W / 2} y={H / 2}>{clip(node.name)}</text></g>}
        </g>
      ))}
    </g>
  </svg>
</div>
<p class="graph-hint">Solid lines connect parents and children, dashed amber lines skip generations, a pink line joins partners and a dashed blue line joins siblings. Dotted lines show other family ties.</p>
