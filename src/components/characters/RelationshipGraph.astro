---
// Build-time SVG relationship diagram. Nodes with a published profile are
// real links; every edge links to its explanation further down the page.
import { checkpointIndex, RELATION_LABEL } from '../../lib/characters/format.ts';
import { characterPath } from '../../lib/characters/registry.ts';
import type { Graph } from '../../lib/characters/graph.ts';
import type { RelationType, SeriesData } from '../../lib/characters/types.ts';
interface Props { graph: Graph; series: SeriesData; label: string; idPrefix?: string }
const { graph, series, label, idPrefix = 'rel' } = Astro.props;
const used = [...new Set(graph.edges.map(edge => edge.relationship.type))] as RelationType[];
const NODE_W = 128;
const NODE_H = 34;
const clip = (name: string) => (name.length > 17 ? `${name.slice(0, 16)}…` : name);
// Parallel edges between the same pair are bent apart.
const pairCount = new Map<string, number>();
const edges = graph.edges.map(edge => {
  const key = [edge.from.id, edge.to.id].sort().join('|');
  const n = pairCount.get(key) || 0;
  pairCount.set(key, n + 1);
  const mx = (edge.from.x + edge.to.x) / 2;
  const my = (edge.from.y + edge.to.y) / 2;
  const dx = edge.to.x - edge.from.x;
  const dy = edge.to.y - edge.from.y;
  const len = Math.hypot(dx, dy) || 1;
  const bend = n * 26;
  const cx = mx + (-dy / len) * bend;
  const cy = my + (dx / len) * bend;
  return { ...edge, d: `M${edge.from.x},${edge.from.y} Q${cx},${cy} ${edge.to.x},${edge.to.y}` };
});
---
<div class="graph-controls" role="group" aria-label="Filter relationship types" data-graph-filters>
  {used.map(type => (
    <button type="button" aria-pressed="true" data-type={type}><span class="swatch" style={`color: var(--rel-${type})`}></span>{RELATION_LABEL[type]}</button>
  ))}
</div>
<div class="graph-wrap">
  <svg class="graph" viewBox={`0 0 ${graph.width} ${graph.height}`} role="group" aria-label={label} data-graph>
    <g>
      {edges.map(edge => {
        const index = checkpointIndex(series, edge.relationship.spoiler);
        const a = graph.nodes.find(n => n.id === edge.relationship.a)!;
        const b = graph.nodes.find(n => n.id === edge.relationship.b)!;
        return (
          <g class={`edge edge--${edge.relationship.type}`} data-type={edge.relationship.type} data-a={a.id} data-b={b.id} data-spoiler-idx={index >= 0 ? index : undefined} data-spoiler-hide={index >= 0 ? '' : undefined} {...(index >= 0 ? { hidden: true } : {})}>
            <a href={`#${idPrefix}-${edge.relationship.id}`} aria-label={`${a.name} and ${b.name}: ${RELATION_LABEL[edge.relationship.type]}. Read how it develops.`}>
              <path d={edge.d} stroke-linecap="round" />
              <path d={edge.d} stroke="transparent" stroke-width="16" />
              <title>{a.name} · {b.name}: {RELATION_LABEL[edge.relationship.type]}</title>
            </a>
          </g>
        );
      })}
    </g>
    <g>
      {graph.nodes.map(node => {
        const own = edges.filter(edge => edge.relationship.a === node.id || edge.relationship.b === node.id);
        // A node whose every connection is spoiler-protected stays hidden until the first of them unlocks.
        const lock = node.focus || own.length === 0 || own.some(edge => !edge.relationship.spoiler)
          ? -1 : Math.min(...own.map(edge => checkpointIndex(series, edge.relationship.spoiler)));
        return (
        <g class={`node${node.focus ? ' node--focus' : ''}${node.profile ? '' : ' node--plain'}`} data-id={node.id} data-spoiler-idx={lock >= 0 ? lock : undefined} data-spoiler-hide={lock >= 0 ? '' : undefined} {...(lock >= 0 ? { hidden: true } : {})} transform={`translate(${node.x - NODE_W / 2},${node.y - NODE_H / 2})`}>
          {node.profile && !node.focus
            ? <a href={characterPath(node.profile)} aria-label={`${node.name}: character profile`}><rect width={NODE_W} height={NODE_H} rx="0" /><text x={NODE_W / 2} y={NODE_H / 2}>{clip(node.name)}</text></a>
            : <g><rect width={NODE_W} height={NODE_H} /><text x={NODE_W / 2} y={NODE_H / 2}>{clip(node.name)}</text></g>}
        </g>
        );
      })}
    </g>
  </svg>
</div>
<p class="graph-hint">Bold names open that character’s profile. Select a line to read how the relationship develops. On a narrow screen, scroll the diagram sideways.</p>
<script>
  import '../../scripts/characters/graph.ts';
</script>
