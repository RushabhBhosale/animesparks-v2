---
import { Image } from 'astro:assets';
import type { ArticleCard } from '../lib/content/types';
import { r2ImageDimensions, r2ImageUrl } from '../lib/content/images';
import { categoryLabel, getUiCopy } from '../lib/content/locales';

export interface Props {
  article: ArticleCard;
  variant?: 'featured' | 'large' | 'standard' | 'compact' | 'horizontal';
  layout?: 'grid' | 'row'; // for backwards compatibility
  locale?: 'en' | 'es';
  showExcerpt?: boolean;
  homepageSelection?: boolean;
}

const {
  article,
  variant: propVariant,
  layout,
  locale = article.language,
  showExcerpt = true,
  homepageSelection = false,
} = Astro.props;

// Map legacy layout prop to variant
const variant = propVariant || (layout === 'row' ? 'horizontal' : 'standard');

const image = r2ImageUrl(article.mainImage);
const imageDimensions = r2ImageDimensions(article.mainImage);
const date = article.publishedAt
  ? new Date(article.publishedAt).toLocaleDateString(locale === 'es' ? 'es-ES' : 'en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : '';

const href = `${locale === 'es' ? '/es' : ''}/blog/${article.slug}`;
const primaryCategory = article.categories?.[0];
const categoryHref = primaryCategory ? `/categories/${primaryCategory.slug}` : undefined;
const copy = getUiCopy(locale);
const imageSizes = variant === 'horizontal'
  ? '(max-width: 700px) 104px, 160px'
  : variant === 'compact'
    ? '72px'
    : '(max-width: 700px) calc(100vw - 32px), (max-width: 1100px) 46vw, 33vw';
const imageWidths = variant === 'horizontal'
  ? [320, 480]
  : variant === 'compact'
    ? [160, 240]
    : [320, 640, 960];
---

<article class:list={[
  'card',
  variant === 'large' && 'card--large',
  variant === 'horizontal' && 'card--row',
  variant === 'compact' && 'card--compact',
  variant === 'featured' && 'card--featured',
]} data-homepage-article={homepageSelection ? (article.translationOfSanityId || article.sanityId) : undefined}>
  <a class="card__image-link" href={href} aria-label={`${copy.readMore}: ${article.title}`}>
    {image ? (
      <Image
        src={image}
        alt={article.mainImage?.alt || article.title}
        widths={imageWidths}
        sizes={imageSizes}
        format="webp"
        quality={80}
        {...(imageDimensions ? { width: imageDimensions.width, height: imageDimensions.height } : { inferSize: true })}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="card__placeholder" aria-hidden="true"></div>
    )}
  </a>

  <div class="card__body">
    <div class="card__meta">
      {primaryCategory && (
        <a class="card__category" href={categoryHref}>
          {categoryLabel(primaryCategory.title, locale)}
        </a>
      )}
      {date && (
        <time class="card__date" datetime={article.publishedAt}>{date}</time>
      )}
    </div>

    <h3 class="card__title">
      <a href={href}>{article.title}</a>
    </h3>

    {variant !== 'compact' && showExcerpt && article.excerpt && (
      <p class="card__excerpt">{article.excerpt}</p>
    )}

    {variant !== 'compact' && (
      <span class="card__author">
        {article.author?.name || (locale === 'es' ? 'Redacción de AnimeSparks' : 'AnimeSparks Editorial')}
      </span>
    )}
  </div>
</article>
