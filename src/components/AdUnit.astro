---
import { ADSENSE_PUBLISHER_ID, ADSENSE_SLOTS, type AdSlotName } from '../lib/adsense';

interface Props {
  slot: AdSlotName;
  class?: string;
}

const { slot, class: className = '' } = Astro.props;
const unit = ADSENSE_SLOTS[slot];
---

<aside class:list={['ad-placement', `ad-placement--${unit.format}`, className]} aria-label="Advertisement">
  <span class="ad-placement__label">Advertisement</span>
  <ins
    class="adsbygoogle"
    style="display:block"
    data-ad-client={ADSENSE_PUBLISHER_ID}
    data-ad-slot={unit.id}
    data-ad-format={unit.format === 'in-feed' ? 'fluid' : 'auto'}
    data-full-width-responsive="true"
  ></ins>
</aside>

<style>
  .ad-placement { min-width: 0; margin-block: 1.75rem; text-align: center; }
  .ad-placement__label { display: block; margin-bottom: .4rem; color: #8d8d8d; font-size: .625rem; letter-spacing: .16em; text-transform: uppercase; }
  .ad-placement.is-unfilled { display: none; }
  .ad-placement--in-feed { margin-block: 1rem; }
</style>
