---
import SiteLayout from '../layouts/SiteLayout.astro';
import Card from './Card.astro';
import AdUnit from './AdUnit.astro';
import type { ArticleCard, CategoryDocument } from '../lib/content/types';
import { homeImage } from '../lib/content/seo';
import { listingHref } from '../lib/content/listing';
import { categoryLabel, getUiCopy } from '../lib/content/locales';

export interface Props {
  eyebrow: string;
  heading: string;
  description: string;
  metaDescription?: string;
  title: string;
  socialTitle?: string;
  canonical: string;
  posts: ArticleCard[];
  categories?: CategoryDocument[];
  tags?: string[];
  locale?: 'en' | 'es';
  path: string;
  query?: string;
  sort?: string;
  range?: string;
  page: number;
  pageCount: number;
  total: number;
  robotsNoindex?: boolean;
  showSearch?: boolean;
  showRange?: boolean;
  showExcerpt?: boolean;
  jsonLd?: unknown[];
}

const {
  eyebrow,
  heading,
  description,
  metaDescription = description,
  title,
  socialTitle = title.replace(/ \| AnimeSparks$/, ''),
  canonical,
  posts,
  categories = [],
  tags = [],
  locale = 'en',
  path,
  query = '',
  sort = '',
  range = '',
  page,
  pageCount,
  total,
  robotsNoindex = false,
  showSearch = false,
  showRange = false,
  showExcerpt = true,
  jsonLd = [],
} = Astro.props;

const es = locale === 'es';
const copy = getUiCopy(locale);
const isBlogArchive = path === '/blogs' || path === '/blogs/es';
const isCategoryDetail = path.startsWith('/categories/');
const isTrending = path === '/trending';
const filters = { q: query || undefined, sort: sort || undefined, range: range || undefined };
---

<SiteLayout
  title={title}
  socialTitle={socialTitle}
  description={metaDescription}
  canonical={canonical}
  image={homeImage}
  lang={locale}
  robotsNoindex={robotsNoindex}
  jsonLd={jsonLd}
  showFooterAd={isBlogArchive || isCategoryDetail || isTrending}
>
  <main class="listing-page" lang={locale}>
    <header class="page-hero">
      <div class="shell">
        <p class="kicker red">{eyebrow}</p>
        <h1>{heading}<span class="text-accent">.</span></h1>
        <p>{description}</p>
      </div>
    </header>

    <div class="shell listing-layout">
      <section class="listing-main" aria-label={heading}>
        {showSearch && (
          <form class="search-form" action={path} method="get">
            <label for="listing-query">{copy.searchArticles}</label>
            <div>
              <input
                id="listing-query"
                type="search"
                name="q"
                value={query}
                placeholder={copy.searchTopic}
              />
              <button type="submit">{copy.search} ↗</button>
            </div>
          </form>
        )}

        <nav class="listing-filters" aria-label={copy.articleOrder}>
          <a
            href={listingHref(path, { q: query || undefined, range: range || undefined }, 1)}
            aria-current={!sort ? 'page' : undefined}
          >
            {copy.allArticlesFilter}
          </a>
          <a
            href={listingHref(path, { q: query || undefined, sort: 'recent', range: range || undefined }, 1)}
            aria-current={sort === 'recent' ? 'page' : undefined}
          >
            {copy.newest}
          </a>
          <a
            href={listingHref(path, { q: query || undefined, sort: 'popular', range: range || undefined }, 1)}
            aria-current={sort === 'popular' ? 'page' : undefined}
          >
            {copy.popular}
          </a>
          <span>{total} {copy.articles}</span>
        </nav>

        {showRange && (
          <nav class="listing-filters" aria-label={copy.timeRange}>
            {(['week', 'month', 'year'] as const).map(value => (
              <a
                href={listingHref(path, { sort: sort || undefined, range: value }, 1)}
                aria-current={range === value ? 'page' : undefined}
              >
                {value}
              </a>
            ))}
            <a href={listingHref(path, { sort: 'discussed', range }, 1)}>{copy.discussed}</a>
            <a href={listingHref(path, { sort: 'visual', range }, 1)}>{copy.visual}</a>
          </nav>
        )}

        {posts.length > 0 ? (
          <div class="story-list">
            {posts.map((post, index) => (
              <>
                <Card article={post} locale={post.language} variant="horizontal" showExcerpt={showExcerpt} />
                {isBlogArchive && index === 4 && <AdUnit slot="blogs2" />}
                {isCategoryDetail && index === 3 && <AdUnit slot="catedet1" />}
                {isCategoryDetail && index === 8 && <AdUnit slot="catedet2" />}
                {isTrending && index === 3 && <AdUnit slot="trend1" />}
                {isTrending && index === 8 && <AdUnit slot="trend2" />}
              </>
            ))}
          </div>
        ) : (
          <p class="empty-state">
            {copy.noArticles}
          </p>
        )}

        {pageCount > 1 && (
          <nav class="pagination" aria-label={copy.pagination}>
            {page > 1 && (
              <a href={listingHref(path, filters, page - 1)}>
                ← {copy.previous}
              </a>
            )}
            <span>{page} / {pageCount}</span>
            {page < pageCount && (
              <a href={listingHref(path, filters, page + 1)}>
                {copy.next} →
              </a>
            )}
          </nav>
        )}
      </section>

      <aside class="listing-sidebar">
        {categories.length > 0 && (
          <section class="side-panel">
            <p class="side-panel__label">{es ? 'Explorar' : 'Explore'}</p>
            <h2>{es ? 'Secciones editoriales' : 'Editorial sections'}</h2>
            <div class="side-links">
              {categories.map(category => (
                <a class="side-link" href={`/categories/${category.slug}`}>
                  <span>{categoryLabel(category.title, locale)}</span>
                  <span aria-hidden="true">→</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {tags.length > 0 && (
          <section class="side-panel">
            <p class="side-panel__label">{copy.furtherReading}</p>
            <h2>{copy.exploreTopic}</h2>
            <div class="tag-cloud">
              {tags.map(tag => (
                <a href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>
              ))}
            </div>
          </section>
        )}

        {isBlogArchive && <AdUnit slot="blogsSidebar" />}

        <section class="side-panel panel-highlight">
          <p class="side-panel__label">{copy.editions}</p>
          <h2>{copy.chooseLanguage}</h2>
          <div style="margin-top: 12px; display: flex; flex-direction: column; gap: 8px;">
            <a href="/blogs" hreflang="en" style="color: #fff; font-weight: 700;">{copy.englishEdition} ↗</a>
            <a href="/blogs/es" hreflang="es" style="color: #fff; font-weight: 700;">{copy.spanishEditionLabel} ↗</a>
          </div>
        </section>
      </aside>
    </div>
  </main>
</SiteLayout>
