---
import '../styles/site.css';
const {
  title,
  description,
  canonical,
  image,
  socialTitle = title,
  englishAlternate,
  spanishAlternate,
  lang = 'en',
  type = 'website',
  jsonLd = [],
  robotsNoindex = false,
} = Astro.props as {
  title: string;
  description: string;
  canonical: string;
  image: string;
  socialTitle?: string;
  englishAlternate?: string;
  spanishAlternate?: string;
  lang?: 'en' | 'es';
  type?: 'website' | 'article';
  jsonLd?: unknown[];
  robotsNoindex?: boolean;
};

// Public HTML is built for the temporary workers.dev deployment. A later
// production build can set PUBLIC_DEPLOY_TARGET=production at build time.
const testHost = import.meta.env.PUBLIC_DEPLOY_TARGET !== 'production';
if (testHost || robotsNoindex) {
  Astro.response.headers.set('X-Robots-Tag', testHost ? 'noindex, nofollow' : 'noindex, follow');
}

const hasAlternates = Boolean(englishAlternate || spanishAlternate);
const englishUrl = hasAlternates ? englishAlternate || (lang === 'en' ? canonical : undefined) : undefined;
const spanishUrl = hasAlternates ? spanishAlternate || (lang === 'es' ? canonical : undefined) : undefined;
const safeJson = (value: unknown) => JSON.stringify(value).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon-48x48.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {englishUrl && <link rel="alternate" hreflang="en" href={englishUrl} />}
  {spanishUrl && <link rel="alternate" hreflang="es" href={spanishUrl} />}
  {hasAlternates && <link rel="alternate" hreflang="x-default" href={englishUrl || canonical} />}
  <meta name="robots" content={testHost ? 'noindex, nofollow' : robotsNoindex ? 'noindex, follow' : 'index, follow'} />
  <meta property="og:title" content={socialTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content="AnimeSparks" />
  <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
  <meta property="og:image" content={image} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={socialTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />
  {jsonLd.map(data => <script type="application/ld+json" set:html={safeJson(data)} />)}
</head>
<body>
  <header class="site-header">
    <div class="shell site-header__inner">
      <a href="/" class="wordmark" aria-label="AnimeSparks home">
        <span class="wordmark__mark" aria-hidden="true">✦</span>
        <span>AnimeSparks</span>
        <span class="text-accent">.</span>
      </a>

      <button type="button" class="menu-toggle" id="menu-toggle-btn" aria-label="Open menu" aria-expanded="false" aria-controls="site-main-nav">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>

      <nav class="site-nav" id="site-main-nav" aria-label="Main navigation">
        <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
        <a href="/categories" aria-current={Astro.url.pathname.startsWith('/categories') ? 'page' : undefined}>Categories</a>
        <a href="/blogs" aria-current={Astro.url.pathname === '/blogs' ? 'page' : undefined}>Latest</a>
        <a href="/trending" aria-current={Astro.url.pathname.startsWith('/trending') ? 'page' : undefined}>Trending</a>
        {lang === 'es' ? (
          <a href={englishUrl || '/blogs'} hreflang="en" class="nav-lang" title="Read in English">EN</a>
        ) : (
          <a href={spanishUrl || '/blogs/es'} hreflang="es" class="nav-lang" title="Leer en Español">ES</a>
        )}
      </nav>

      <div class="header-search">
        <button type="button" class="header-search__toggle" id="search-toggle-btn" aria-label="Open search" aria-expanded="false" aria-controls="header-search-form">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        </button>

        <form class="header-search__form" id="header-search-form" action="/search" method="get" role="search" hidden>
          <label class="sr-only" for="header-query">Search AnimeSparks</label>
          <input id="header-query" type="search" name="q" placeholder="Search series, articles..." autocomplete="off" />
          <button type="submit" aria-label="Submit search">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </form>
        <div class="header-suggestions" id="header-suggestions" hidden></div>
      </div>
    </div>
  </header>

  <slot />

  <footer class="site-footer">
    <div class="shell site-footer__top">
      <div class="footer-brand">
        <a href="/" class="wordmark">
          <span class="wordmark__mark" aria-hidden="true">✦</span>
          <span>AnimeSparks</span>
          <span class="text-accent">.</span>
        </a>
        <p>Anime, examined closely.<br />Thoughtful analysis, sharp reviews, and character studies that stay with you.</p>
      </div>

      <nav class="footer-nav" aria-label="Footer explore">
        <h2>Explore</h2>
        <a href="/blogs">All blogs</a>
        <a href="/categories">Editorial sections</a>
        <a href="/trending">Trending now</a>
        <a href="/my-anime-list">My anime list</a>
        <a href="/blogs/es" hreflang="es">En español</a>
      </nav>

      <nav class="footer-nav" aria-label="Publication">
        <h2>Publication</h2>
        <a href="/about">About AnimeSparks</a>
        <a href="/contact">Contact</a>
        <a href="/rss.xml">RSS feed</a>
        <a href="/sitemap">Sitemap</a>
      </nav>
    </div>

    <div class="shell site-footer__bottom">
      <div>© {new Date().getFullYear()} AnimeSparks. All rights reserved.</div>
      <div><a href="/privacy">Privacy policy</a></div>
    </div>
  </footer>

  <script>
    // Header search interaction
    const searchToggle = document.getElementById('search-toggle-btn');
    const searchForm = document.getElementById('header-search-form') as HTMLFormElement | null;
    const searchInput = document.getElementById('header-query') as HTMLInputElement | null;
    const searchSuggestions = document.getElementById('header-suggestions') as HTMLDivElement | null;

    if (searchToggle && searchForm && searchInput) {
      searchToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = !searchForm.hidden;
        searchForm.hidden = isOpen;
        searchToggle.setAttribute('aria-expanded', String(!isOpen));
        if (!isOpen) {
          searchInput.focus();
        } else if (searchSuggestions) {
          searchSuggestions.hidden = true;
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !searchForm.hidden) {
          searchForm.hidden = true;
          searchToggle.setAttribute('aria-expanded', 'false');
          if (searchSuggestions) searchSuggestions.hidden = true;
          searchToggle.focus();
        }
      });

      document.addEventListener('click', (e) => {
        const target = e.target as Node;
        if (!searchForm.contains(target) && !searchToggle.contains(target)) {
          searchForm.hidden = true;
          searchToggle.setAttribute('aria-expanded', 'false');
          if (searchSuggestions) searchSuggestions.hidden = true;
        }
      });

      let timer: number | undefined;
      let controller: AbortController | undefined;

      searchInput.addEventListener('input', () => {
        window.clearTimeout(timer);
        controller?.abort();
        const query = searchInput.value.trim();
        if (query.length < 2) {
          if (searchSuggestions) {
            searchSuggestions.hidden = true;
            searchSuggestions.replaceChildren();
          }
          return;
        }

        timer = window.setTimeout(async () => {
          controller = new AbortController();
          try {
            const res = await fetch(`/api/search?q=${encodeURIComponent(query)}`, { signal: controller.signal });
            if (!res.ok || !searchSuggestions) return;
            const data = await res.json() as { results?: Array<{ title: string; slug: string }> };
            searchSuggestions.replaceChildren();
            for (const item of (data.results || []).slice(0, 6)) {
              const link = document.createElement('a');
              link.href = `/blog/${encodeURIComponent(item.slug)}`;
              link.textContent = item.title;
              searchSuggestions.append(link);
            }
            searchSuggestions.hidden = searchSuggestions.childElementCount === 0;
          } catch {
            if (searchSuggestions) searchSuggestions.hidden = true;
          }
        }, 220);
      });
    }

    // Mobile nav drawer
    const menuBtn = document.getElementById('menu-toggle-btn');
    const mainNav = document.getElementById('site-main-nav');
    if (menuBtn && mainNav) {
      const mobileMenuQuery = window.matchMedia('(max-width: 820px)');
      const setMenuOpen = (open: boolean) => {
        menuBtn.setAttribute('aria-expanded', String(open));
        menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        mainNav.classList.toggle('is-open', open);
        mainNav.inert = mobileMenuQuery.matches && !open;
        document.body.classList.toggle('menu-open', open);
      };

      mainNav.inert = mobileMenuQuery.matches;
      menuBtn.addEventListener('click', () => {
        const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
        setMenuOpen(!isExpanded);
      });

      document.addEventListener('keydown', event => {
        if (event.key === 'Escape' && menuBtn.getAttribute('aria-expanded') === 'true') {
          setMenuOpen(false);
          menuBtn.focus();
        }
      });

      mobileMenuQuery.addEventListener('change', () => setMenuOpen(false));
    }
  </script>
</body>
</html>
