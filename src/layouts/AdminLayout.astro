---
import '../styles/admin.css';
import { env } from 'cloudflare:workers';
import { verifySession } from '../lib/admin/auth';
import { isWritesEnabled } from '../lib/admin/write-guard';

export interface Props {
  title?: string;
  activeNav?: 'dashboard' | 'articles' | 'anime' | 'categories' | 'media' | 'homepage' | 'settings';
}

const { title = 'AnimeSparks Admin', activeNav = 'dashboard' } = Astro.props;

// Enforce strict server-side authentication
const user = await verifySession(Astro.request, env.ADMIN_JWT_SECRET);
if (!user) {
  return Astro.redirect('/admin/login');
}
const username = user;

// Strictly prevent any indexing of CMS routes
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const writesEnabled = isWritesEnabled(env);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon-48x48.png" />
  <title>{title} — AnimeSparks CMS</title>
  <meta name="robots" content="noindex, nofollow" />
</head>
<body class="admin-body">
  <div class="admin-shell">
    <!-- Admin Sidebar -->
    <aside class="admin-sidebar">
      <div class="admin-sidebar__brand">
        <div class="admin-sidebar__logo" aria-hidden="true">✦</div>
        <div class="admin-sidebar__title">AnimeSparks</div>
        <span class="admin-sidebar__badge">CMS</span>
      </div>

      <nav class="admin-nav" aria-label="Admin Navigation">
        <a href="/admin" class:list={[activeNav === 'dashboard' && 'active']}>
          <svg class="admin-nav__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span>Dashboard</span>
        </a>

        <a href="/admin/articles" class:list={[activeNav === 'articles' && 'active']}>
          <svg class="admin-nav__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
          <span>Articles</span>
        </a>

        <a href="/admin/anime" class:list={[activeNav === 'anime' && 'active']}>
          <svg class="admin-nav__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 4v16M17 4v16M3 8h4m10 0h4M3 12h18M3 16h4m10 0h4M4 20h16a1 1 0 001-1V5a1 1 0 00-1-1H4a1 1 0 00-1 1v14a1 1 0 001 1z" />
          </svg>
          <span>Anime Database</span>
        </a>

        <a href="/admin/categories" class:list={[activeNav === 'categories' && 'active']}>
          <svg class="admin-nav__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
          </svg>
          <span>Categories</span>
        </a>

        <a href="/admin/media" class:list={[activeNav === 'media' && 'active']}>
          <svg class="admin-nav__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Media (R2)</span>
        </a>

        <a href="/admin/homepage" class:list={[activeNav === 'homepage' && 'active']}>
          <svg class="admin-nav__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z" />
          </svg>
          <span>Homepage</span>
        </a>

        <a href="/admin/settings" class:list={[activeNav === 'settings' && 'active']}>
          <svg class="admin-nav__icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          <span>System & Safety</span>
        </a>
      </nav>

      <div class="admin-sidebar__footer">
        <a href="https://www.animesparks.blog/" target="_blank" rel="noopener noreferrer" style="color: var(--admin-text-muted); text-decoration: none;">
          View Public Site ↗
        </a>
        <span>v2.0</span>
      </div>
    </aside>

    <!-- Main Content -->
    <div class="admin-main">
      <!-- Topbar -->
      <header class="admin-topbar">
        <div class="admin-topbar__status">
          {writesEnabled ? (
            <span class="badge badge--published">Writes Enabled</span>
          ) : (
            <span class="badge badge--draft" title="Production writes disabled via ADMIN_WRITES_ENABLED">
              Read-Only Safety Mode
            </span>
          )}
        </div>

        <div class="admin-topbar__user">
          <div class="admin-user-pill">
            <span class="admin-user-avatar">{username[0]?.toUpperCase() || 'A'}</span>
            <span>{username}</span>
          </div>

          <form action="/api/admin/auth/logout" method="POST" style="margin: 0;">
            <button type="submit" class="btn btn--secondary btn--sm">
              Log out
            </button>
          </form>
        </div>
      </header>

      <!-- Content View -->
      <main class="admin-content">
        {!writesEnabled && (
          <div class="write-guard-banner">
            <div>
              <strong>Safety Guard Active:</strong> All production database and media mutations are locked (<code>ADMIN_WRITES_ENABLED=false</code>). Content is safe to browse and preview.
            </div>
            <a href="/admin/settings" class="btn btn--secondary btn--sm" style="color: inherit;">
              View Safety Status
            </a>
          </div>
        )}

        <slot />
      </main>
    </div>
  </div>
</body>
</html>
