{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "animesparks-v2",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-07",
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    // false keeps `astro dev` able to serve Vite client assets. Both deploy
    // preparations (scripts/prepare-deploy.mjs, scripts/prepare-production.mjs)
    // set run_worker_first: true in the deployed config.
    "run_worker_first": false,
  },
  "routes": [{ "pattern": "admin.animesparks.blog", "custom_domain": true }],
  "vars": {
    "MONGODB_DB_NAME": "animesparks",
    // Keep all admin database and R2 mutations disabled during pre-production.
    "ADMIN_WRITES_ENABLED": "false",
    "PUBLISHING_WRITES_ENABLED": "false",
    // Search falls back to a live Tenrai lookup for titles missing from the
    // catalogue and saves them to toolAnime (insert-only). "false" disables it.
    "TOOLS_LIVE_LOOKUP": "true",
  },
  // Native R2 bucket binding — images.animesparks.blog is a custom domain on this bucket.
  // The bucket name is confirmed as "animesparks-staging".
  // Never expose R2 credentials to the browser; all access is server-side via this binding.
  "r2_buckets": [
    {
      "binding": "IMAGES_BUCKET",
      "bucket_name": "animesparks-staging",
    },
  ],
}
